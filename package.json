{
  "name": "agps",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "shared",
    "server",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n server,frontend -c yellow,magenta \"npm:dev:server\" \"npm:dev:frontend\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=shared && npm run build --workspace=server && npm run build --workspace=frontend",
    "seed": "npm run seed --workspace=server",
    "test": "npm run test --workspace=server",
    "lint": "npm run lint --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": "22.x"
  }
}
