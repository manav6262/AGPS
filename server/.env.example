# AGPS — server environment
# Copy to server/.env and fill in real values. NEVER commit server/.env

# --- Database ---
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/agps?retryWrites=true&w=majority
# Local:  mongodb://localhost:27017/agps
# If the password contains @ : / ? # [ ] % it must be URL-encoded (@ becomes %40)
MONGODB_URI=mongodb://localhost:27017/agps

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Auth ---
# Use long random strings (32+ chars). The two secrets MUST differ.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-DIFFERENT-long-random-string-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- CORS ---
# Must match the frontend dev server origin
CORS_ORIGIN=http://localhost:5173
